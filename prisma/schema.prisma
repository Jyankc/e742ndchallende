generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Source {
  orders
  refunds
  email_events
  ad_spend
}

enum RunStatus {
  pending
  processing
  completed
  failed
}

model Company {
  id   String @id
  name String

  runs        IngestionRun[]
  orders      Order[]
  refunds     Refund[]
  emailEvents EmailEvent[]
  adSpend     AdSpend[]

  @@map("companies")
}

model IngestionRun {
  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  id              String    @id @default(uuid()) @db.Uuid
  company_id      String
  source          Source
  idempotency_key String
  uploaded_by     String?
  reused_run_id   String?   @db.Uuid
  file_path       String
  file_hash       String
  status          RunStatus @default(pending)
  attempt_count   Int       @default(0)
  claim_token     String?   @db.Uuid
  lease_expires_at DateTime? @db.Timestamptz(3)
  next_attempt_at DateTime  @default(now()) @db.Timestamptz(3)
  error_code      Int?
  error           String?
  inserted_count  Int       @default(0)
  duplicate_count Int       @default(0)
  created_at      DateTime  @default(now()) @db.Timestamptz(3)
  updated_at      DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([company_id, source, idempotency_key])
  @@index([company_id, source, file_hash, status])
  @@index([status, next_attempt_at, created_at])
  @@index([status, lease_expires_at])
  @@map("ingestion_runs")
}

model Order {
  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company_id     String
  order_id       String
  created_at     DateTime @db.Timestamptz(3)
  channel        String
  gross          Decimal  @db.Decimal(18, 2)
  currency       String
  customer_email String
  record_hash    String
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@id([company_id, order_id])
  @@map("orders")
}

model Refund {
  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company_id  String
  refund_id   String
  refunded_at DateTime @db.Timestamptz(3)
  order_id    String
  amount      Decimal  @db.Decimal(18, 2)
  currency    String
  record_hash String
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@id([company_id, refund_id])
  @@map("refunds")
}

model EmailEvent {
  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company_id  String
  event_id    String
  type        String
  email       String
  campaign_id String
  occurred_at DateTime @db.Timestamptz(3)
  record_hash String
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@id([company_id, event_id])
  @@map("email_events")
}

model AdSpend {
  company Company @relation(fields: [company_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  company_id  String
  date        DateTime @db.Date
  campaign_id String
  platform    String
  spend       Decimal  @db.Decimal(18, 2)
  record_hash String
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@id([company_id, date, platform, campaign_id])
  @@map("ad_spend")
}
